# Copie este archivo como .env y complete los valores. Este archivo nunca se sube a GitHub.
QBO_CLIENT_ID=pegue_aqui_el_client_id
QBO_CLIENT_SECRET=pegue_aqui_el_client_secret
# Direccion a la que Intuit devuelve despues de conectar. Debe estar registrada en la app de Intuit.
# En su computador: http://localhost:8000/auth/callback   En Render: https://SU-APP.onrender.com/auth/callback
QBO_REDIRECT_URI=http://localhost:8000/auth/callback
# sandbox (empresa de prueba) o production (empresa real)
QBO_ENVIRONMENT=sandbox
# Texto largo y aleatorio para cifrar la sesion de cada navegador
SESSION_SECRET=cambie_esto_por_un_texto_largo_y_aleatorio
